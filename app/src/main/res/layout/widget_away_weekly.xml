<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weekly_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_weekly"
    android:padding="20dp">

    <!-- Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_weekly_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Weekly away time"
            android:textColor="#EEFFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <ImageView
            android:id="@+id/iv_weekly_sparkle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_sparkle_white"
            android:contentDescription="Sparkle" />
    </RelativeLayout>

    <!-- Total Weekly Time -->
    <TextView
        android:id="@+id/tv_weekly_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="30 hr 28 min"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Date Range -->
    <TextView
        android:id="@+id/tv_weekly_dates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="23 August - 29 August"
        android:textColor="#C7FFFFFF"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <!-- Day Average Pill Banner -->
    <LinearLayout
        android:id="@+id/layout_day_average"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_average"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◎"
            android:textColor="#EEFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Day average"
            android:textColor="#EEFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_day_average_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11 hr 19 min"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Chart View -->
    <ImageView
        android:id="@+id/iv_weekly_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:contentDescription="Weekly Activity Chart" />

    <!-- Pager Dots at bottom (using FrameLayout instead of View) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_pill_average" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_average" />
    </LinearLayout>

</LinearLayout>
